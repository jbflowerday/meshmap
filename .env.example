# Copy to .env and change the passwords before exposing anything publicly.

# ---- MQTT broker (Mosquitto)
MQTT_PORT=1883
MQTT_ROOT_TOPIC=msh
# Account the backend uses (read-only on msh/#)
MQTT_BACKEND_USER=meshmap
MQTT_BACKEND_PASSWORD=change-me-backend
# Account you configure on your Meshtastic nodes (read/write on msh/#)
MQTT_NODE_USER=meshdev
MQTT_NODE_PASSWORD=change-me-nodes
# Let nodes connect without credentials (not recommended on the open internet)
MQTT_ALLOW_ANONYMOUS=false

# ---- Backend
MQTT_TOPICS=msh/#
# Comma separated base64 channel PSKs used to decrypt uplinked packets. AQ== = default LongFast key.
MESH_CHANNEL_KEYS=AQ==
RETENTION_DAYS=7
NODE_MAX_AGE_DAYS=30
LINK_MAX_AGE_HOURS=72
# Hide positions less precise than this many bits (0 = show everything nodes send)
MIN_PRECISION_BITS=0

# Ask unnamed nodes for their name (like "Exchange user info" in the app), via MQTT
# downlink through the gateway that heard them. Needs Downlink enabled on the gateway's
# primary channel. Uses airtime, so it's rate limited.
NAME_REQUESTS=false
NAME_REQUEST_MAX_PER_HOUR=6
NAME_REQUEST_RETRY_HOURS=12
# Node id MeshMap uses for requests (random and remembered if empty), and its name on the mesh
NAME_REQUEST_NODE_ID=
NAME_REQUEST_LONG_NAME=MeshMap
NAME_REQUEST_SHORT_NAME=MMap

# ---- Frontend (baked in at build time; rebuild after changing)
WEB_PORT=8080
SITE_TITLE=MeshMap
# Initial view before nodes load, "lat,lon"
MAP_CENTER=
MAP_ZOOM=
# Optional custom dark tile server, e.g. a Stadia/MapTiler URL with your key
TILE_URL=
TILE_ATTRIBUTION=
